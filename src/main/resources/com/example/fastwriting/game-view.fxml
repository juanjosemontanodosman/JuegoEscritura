<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.example.fastwriting.controller.GameController"
           styleClass="root-pane" stylesheets="@styles.css">

    <!-- ===================== GAME SCREEN ===================== -->
    <BorderPane>
        <padding>
            <Insets top="24" right="32" bottom="24" left="32"/>
        </padding>

        <!-- Top: title and game status -->
        <top>
            <VBox spacing="12">
                <HBox alignment="CENTER_LEFT" spacing="12">
                    <Label text="Escritura Rápida" styleClass="title"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label fx:id="bestScoreLabel" text="Récord: 0" styleClass="chip"/>
                </HBox>
                <HBox alignment="CENTER_LEFT" spacing="12">
                    <Label fx:id="levelLabel" text="Nivel 1" styleClass="chip, chip-level"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label text="⏱" styleClass="time-icon"/>
                    <Label fx:id="timeLabel" text="20 s" styleClass="time-label"/>
                </HBox>
                <ProgressBar fx:id="timeProgressBar" progress="1.0" maxWidth="Infinity"
                             styleClass="time-bar"/>
            </VBox>
        </top>

        <!-- Center: word to type and answer field -->
        <center>
            <VBox alignment="CENTER" spacing="18">
                <Label text="Escribe esta palabra:" styleClass="hint"/>
                <VBox alignment="CENTER" styleClass="word-card" maxWidth="560">
                    <Label fx:id="wordLabel" text="¿Listo?" styleClass="word" wrapText="true"/>
                </VBox>
                <TextField fx:id="answerField" promptText="Escribe aquí y presiona Enter"
                           maxWidth="560" styleClass="answer-field"/>
                <Label fx:id="messageLabel" styleClass="message, message-info" wrapText="true"/>
            </VBox>
        </center>

        <!-- Bottom: actions -->
        <bottom>
            <HBox alignment="CENTER" spacing="16">
                <Button fx:id="validateButton" text="Validar" onAction="#onValidateButtonClick"
                        styleClass="primary-button"/>
                <Label text="Enter: validar   ·   Esc: borrar" styleClass="hint"/>
            </HBox>
        </bottom>
    </BorderPane>

    <!-- ============ OVERLAY: welcome / end-of-game summary ============ -->
    <StackPane fx:id="overlayPane" styleClass="overlay">
        <VBox alignment="CENTER" spacing="16" styleClass="overlay-card" maxWidth="460" maxHeight="360">
            <Label fx:id="overlayTitleLabel" text="Escritura Rápida" styleClass="overlay-title"/>
            <Label fx:id="overlayContentLabel" styleClass="overlay-content" wrapText="true"/>
            <Button fx:id="overlayButton" text="Comenzar" onAction="#onOverlayButtonClick"
                    styleClass="primary-button"/>
        </VBox>
    </StackPane>
</StackPane>
